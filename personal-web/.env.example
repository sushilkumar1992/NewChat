# Copy to .env and fill from the SAM stack outputs, then restart `npm run dev`.

# HTTP API base (config, suggestions, session + per-message feedback)
VITE_API_BASE_URL=https://xxxxxx.execute-api.us-east-2.amazonaws.com

# Streaming Lambda Function URL (POST, RESPONSE_STREAM) — PRIVATE (AWS_IAM).
# The frontend SigV4-signs this with the temporary AWS creds from the Cognito Identity Pool.
VITE_STREAM_URL=https://xxxxxxxxxxxx.lambda-url.us-east-2.on.aws/

# --- Cognito (login + private streaming access) — all from the SAM stack outputs ---
VITE_AWS_REGION=us-east-2
VITE_COGNITO_USER_POOL_ID=us-east-2_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_IDENTITY_POOL_ID=us-east-2:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Per-message feedback thumbs (up/down) on each bot answer: yes|no (default yes)
VITE_ENABLE_MESSAGE_FEEDBACK=yes
