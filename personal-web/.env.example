# Copy to .env and fill from the SAM stack outputs
# HTTP API base (sessions, feedback, end, config, suggestions)
VITE_API_BASE_URL=https://xxxxxx.execute-api.us-east-1.amazonaws.com
# Streaming Lambda Function URL (POST /messages, RESPONSE_STREAM)
VITE_STREAM_URL=https://xxxxxxxxxxxx.lambda-url.us-east-1.on.aws/
# Per-message feedback thumbs (up/down) on each bot answer: yes|no (default yes)
VITE_ENABLE_MESSAGE_FEEDBACK=yes
