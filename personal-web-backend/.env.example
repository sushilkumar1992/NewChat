# ============================================================================
# Backend environment reference (personal-web-backend)
# ----------------------------------------------------------------------------
# In production these values are set on each Lambda by SAM (template.yaml
# `Environment.Variables`), and AGENT_RUNTIME_ARN is a SAM deploy parameter.
# This file documents every variable and doubles as a source for local testing
# and for `sam deploy --parameter-overrides`. Copy to `.env` for local use;
# `.env` is gitignored, this example is committed.
# ============================================================================

# ---- Region -----------------------------------------------------------------
# Set automatically by the Lambda runtime at execution time; listed here for
# local runs / CLI commands. Must match where your tables and agent live.
AWS_REGION=us-east-2

# ---- Deploy parameters (passed to SAM, not read by the function code) --------
# Stack the two Lambdas + HTTP API deploy into.
SAM_STACK_NAME=personal-web-backend
# Bedrock AgentCore runtime the streaming Lambda invokes (REQUIRED — no default).
#   sam deploy --parameter-overrides AgentRuntimeArn=$AGENT_RUNTIME_ARN
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-2:<ACCOUNT_ID>:runtime/<runtime-id>

# ---- DynamoDB table names ---------------------------------------------------
# Defaults match template.yaml and the console tables in DEPLOYMENT.md.
# Streaming Lambda writes: TABLE_MESSAGES
# API Lambda reads/writes: the other four
TABLE_SESSIONS=pva_sessions
TABLE_MESSAGES=pva_messages
TABLE_MESSAGE_FEEDBACK=pva_message_feedback
TABLE_CONFIG=pva_config
TABLE_SUGGESTIONS=pva_suggestions

# ---- API Lambda options (optional; sensible defaults in code) ----------------
# Partition-key value of the single row in pva_config.
CONFIG_KEY=default
# Max suggested questions returned by GET /suggestions (top N by `count`).
SUGGESTIONS_LIMIT=5
