# ============================================================================
# Backend environment reference (personal-web-backend)
# ----------------------------------------------------------------------------
# In production these values are set on each Lambda by SAM (template.yaml
# `Environment.Variables`), and AgentRuntimeArn / FrontendOrigin are SAM deploy
# parameters. This file documents every variable and doubles as a source for
# local testing and for `sam deploy --parameter-overrides`. Copy to `.env` for
# local use; `.env` is gitignored, this example is committed.
# ============================================================================

# ---- Region -----------------------------------------------------------------
# Set automatically by the Lambda runtime at execution time; listed here for
# local runs / CLI commands. Must match where your tables and agent live.
AWS_REGION=us-east-2

# ---- Deploy parameters (passed to SAM, not read by the function code) --------
# Stack the two Lambdas + HTTP API + Cognito deploy into.
SAM_STACK_NAME=personal-web-backend
# Bedrock AgentCore runtime the streaming Lambda invokes (REQUIRED — no default).
#   sam deploy --parameter-overrides AgentRuntimeArn=$AGENT_RUNTIME_ARN FrontendOrigin=$FRONTEND_ORIGIN
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-2:<ACCOUNT_ID>:runtime/<runtime-id>
# Exact browser origin of the frontend (REQUIRED — no default). Locks CORS on both the
# HTTP API and the streaming Function URL (replaces the old "*").
FRONTEND_ORIGIN=https://app.example.com

# ---- DynamoDB table --------------------------------------------------------
# Single table (PK/SK) shared by both Lambdas. Default matches template.yaml
# and the console table in DEPLOYMENT.md.
TABLE_NAME=RBPOCTable

# ---- API Lambda options (optional; sensible defaults in code) ----------------
# Sort-key value of the config row (PK "CONFIG") in the single table.
CONFIG_KEY=default
# Max suggested questions returned by GET /suggestions (top N by `count`).
SUGGESTIONS_LIMIT=5

# ---- Cognito ---------------------------------------------------------------
# Created by template.yaml. After `sam deploy`, copy these stack outputs into the
# FRONTEND .env (personal-web/.env): UserPoolId, UserPoolClientId, IdentityPoolId, AwsRegion.
# Users are admin-created only — see docs/cognito-auth-setup.md for the admin-create-user command.
